# Required. Gemini API key, free at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Required. Web search. Free key (1,000 searches/month) at https://app.tavily.com
TAVILY_API_KEY=

# Optional overrides. Model lists are tried in order; a model that is
# rate-limited or unavailable is skipped for two minutes.
# PORT=3000
# ANSWER_MODELS=gemini-3.5-flash,gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash-lite
# PLANNER_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite
# DB_PATH=data/agent.db
